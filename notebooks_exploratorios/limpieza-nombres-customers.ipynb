{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Limpieza de Nombres - Customers\n",
    "Prueba de la función `clean_name` con datos reales"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# Celda de configuración inicial\n",
    "try:\n",
    "    from databricks.connect import DatabricksSession\n",
    "    spark = DatabricksSession.builder.profile(\"ecommerce-etl-pipeline\").getOrCreate()\n",
    "    print(\"Sesión Spark creada\")\n",
    "except Exception as e:\n",
    "    print(f\"Usando spark existente: {e}\")\n",
    "\n",
    "import sys, os\n",
    "sys.path.insert(0, os.path.abspath(os.path.join(os.getcwd(), \"..\")))\n",
    "print(f\"Path: {sys.path[0]}\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# 1. Cargar datos crudos de bronze\n",
    "storage_account_name = \"stecommercedirty01\"\n",
    "container = \"bronze\"\n",
    "path = f\"abfss://{container}@{storage_account_name}.dfs.core.windows.net/customers/\"\n",
    "\n",
    "df_customers = spark.read.option(\"multiLine\", True).json(path)\n",
    "print(f\"Filas: {df_customers.count()}\")\n",
    "df_customers.printSchema()"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# 2. Ver los nombres sucios ANTES de limpiar\n",
    "df_customers.select(\"name\", \"email\", \"city\", \"country\").show(20, truncate=False)"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# 3. Importar funciones de limpieza\n",
    "from transformacion.cleaning import clean_name, clean_email\n",
    "\n",
    "# Aplicar limpieza a name, city y email\n",
    "df_limpio = clean_name(df_customers, \"name\")\n",
    "df_limpio = clean_name(df_limpio, \"city\")\n",
    "df_limpio = clean_email(df_limpio)\n",
    "\n",
    "print(\"Columnas nuevas:\", [c for c in df_limpio.columns if c.endswith(\"_clean\")])"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# 4. Comparar ANTES vs DESPUÉS de la limpieza\n",
    "from pyspark.sql.functions import col\n",
    "\n",
    "df_limpio.select(\n",
    "    col(\"name\"), col(\"name_clean\"),\n",
    "    col(\"email\"), col(\"email_clean\"),\n",
    "    col(\"city\"), col(\"city_clean\")\n",
    ").filter(col(\"name_clean\") != col(\"name\")) \\\n",
    "    .show(30, truncate=False)"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# 5. Verificar caracteres especiales ELIMINADOS en name\n",
    "from pyspark.sql.functions import regexp_extract\n",
    "\n",
    "especiales = df_limpio.filter(\n",
    "    regexp_extract(col(\"name_clean\"), \"[^a-zA-Z\\\\s'-]\", 0) != \"\"\n",
    ").select(\"name\", \"name_clean\")\n",
    "\n",
    "print(f\"Nombres con caracteres especiales restantes: {especiales.count()}\")\n",
    "especiales.show(10)"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# 6. Verificar emails inválidos → UNKNOWN\n",
    "df_limpio.filter(col(\"email_clean\") == \"UNKNOWN\") \\\n",
    "    .select(\"email\", \"email_clean\") \\\n",
    "    .show(20, truncate=False)\n",
    "\n",
    "print(f\"Total emails UNKNOWN: {df_limpio.filter(col('email_clean') == 'UNKNOWN').count()}\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {},
   "source": [
    "# 7. Vista final limpia\n",
    "df_limpio.select(\n",
    "    \"id\", \"name_clean\", \"email_clean\", \"city_clean\"\n",
    ").show(30, truncate=False)"
   ],
   "outputs": []
  }
 ],
